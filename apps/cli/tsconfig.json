{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "outDir": "../apps/cli/dists/cli/dist",
    "rootDir": "../apps/cli/srcps/cli/src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["../apps/cli/src/**/*cli/src/**/*"],
  "exclude": ["../apps/cli/node_modulesnode../apps/cli/distules", "../apps/cli/dist"]
}
