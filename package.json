{
  "name": "employment-bot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "discord": "npm run start --workspace=@apps/discord",
    "discord:dev": "npm run dev --workspace=@apps/discord",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "type": "module",
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "discord.js": {
      "undici": "^6.27.0"
    },
    "uuid": "^11.1.1"
  },
  "workspaces": [
    "packages/scraper",
    "packages/shared",
    "packages/ai",
    "packages/database",
    "packages/email",
    "apps/*"
  ]
}
